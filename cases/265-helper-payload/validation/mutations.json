{
  "mutants": [
    [
      "speed-field",
      "numberInput('wb-in-sections-speed',150,()=>refresh(),false)",
      "numberInput('wb-in-sections-speed',150,x=>{inputs.airspeed=x;refresh();},false)"
    ],
    [
