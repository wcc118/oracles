      "onchange:()=>{if(chordOf(surface.value))",
      "onchange:()=>{inputs.surface=surface.value;if(chordOf(surface.value))"
    ]
  ],
  "alternative": [
    "numberInput('wb-in-sections-speed',150,",
    "numberInput('wb-in-sections-speed',160,"
  ]
}
