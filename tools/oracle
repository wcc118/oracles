#!/usr/bin/env python3
"""
Oracle CLI: load case manifests, run checks, validate against workspaces, detect leakage.
"""
import argparse
import hashlib
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

try:
    import jsonschema
except ImportError:
    jsonschema = None

# Paths
SCRIPT_DIR = Path(__file__).resolve().parent
ROOT_DIR = SCRIPT_DIR.parent
CASES_DIR = ROOT_DIR / "cases"
SCHEMA_FILE = ROOT_DIR / "schema" / "case.schema.json"
RESTRICTED_DIRS = ["cases/*/oracle/", "cases/*/validation/", "registry/", "ledger/"]

# Standard library validators
ENUM_VALIDATORS = {
    "strength": ["invariant-or-residual", "independent-reference", "converged-and-reviewed", "golden-master", "validated-against-data"],
    "status": ["probation", "active", "retired", "draft"],
    "suite": ["tuning", "heldout"],
    "runtime": ["python", "node-vm", "browser"],
}

TYPE_VALIDATORS = {
    "id": str,
    "task_class": str,
    "strength": str,
    "status": str,
    "suite": str,
    "runtime": str,
    "origin": dict,
    "registry_refs": list,
    "memory_refs": list,
    "hashes": dict,
    "notes": str,
}


def load_schema():
    """Load the case schema JSON."""
    with open(SCHEMA_FILE) as f:
        return json.load(f)


def derive_validators_from_schema(schema):
    """Derive enum and type validators from the schema at load time."""
    enums = dict(ENUM_VALIDATORS)  # Start with defaults
    types = dict(TYPE_VALIDATORS)
    required = ["id", "task_class", "runtime", "strength", "hashes", "origin", "suite", "status"]

    if schema and schema.get("type") == "object":
        props = schema.get("properties", {})
        required = schema.get("required", [])

        for field, spec in props.items():
            # Collect enum values
            if "enum" in spec:
                enums[field] = spec["enum"]

            # Collect type info
            if "type" in spec:
                type_map = {
                    "string": str,
                    "integer": int,
                    "number": (int, float),
                    "boolean": bool,
                    "array": list,
                    "object": dict,
                }
                types[field] = type_map.get(spec["type"], str)

            # Handle nested required keys
            if "properties" in spec:
                nested_required = spec.get("required", [])
                for nested_field in nested_required:
                    if nested_field in spec["properties"]:
                        nested_spec = spec["properties"][nested_field]
                        if "type" in nested_spec:
                            nested_type_map = {
                                "string": str,
                                "integer": int,
                                "number": (int, float),
                                "boolean": bool,
                                "array": list,
                                "object": dict,
                            }
                            types[f"{field}.{nested_field}"] = nested_type_map.get(nested_spec["type"], str)

    return enums, types, required


# Global validators (derived at module load time)
SCHEMA = load_schema()
ENUM_VALIDATORS, TYPE_VALIDATORS, REQUIRED_FIELDS = derive_validators_from_schema(SCHEMA)


def validate_manifest(manifest, case_id):
    """Validate a manifest against derived validators. Returns error message or None."""
    # Check required fields
    for field in REQUIRED_FIELDS:
        if field not in manifest:
            return f"missing required field '{field}' in {case_id}"

    # Check enum fields
    for field, allowed_values in ENUM_VALIDATORS.items():
        if field in manifest:
            value = manifest[field]
            if value not in allowed_values:
                return f"invalid enum value '{value}' for field '{field}' in {case_id}"

    # Check type fields
    for field, expected_type in TYPE_VALIDATORS.items():
        if field in manifest:
            value = manifest[field]
            if not isinstance(value, expected_type):
                return f"wrong type for field '{field}' in {case_id} (expected {expected_type.__name__}, got {type(value).__name__})"

    # Check nested hashes structure
    if "hashes" in manifest:
        hashes = manifest["hashes"]
        if not isinstance(hashes, dict):
            return f"wrong type for field 'hashes' in {case_id} (expected dict, got {type(hashes).__name__})"
        for hash_field in ["input", "task", "check"]:
            if hash_field not in hashes:
                return f"missing required nested key 'hashes.{hash_field}' in {case_id}"

    # Check origin structure
    if "origin" in manifest:
        origin = manifest["origin"]
        if not isinstance(origin, dict):
            return f"wrong type for field 'origin' in {case_id} (expected dict, got {type(origin).__name__})"

    return None


def load_manifest(case_id):
    """Load and validate a case manifest. Returns (manifest, error)."""
    manifest_path = CASES_DIR / case_id / "manifest.json"
    if not manifest_path.exists():
        return None, f"manifest not found: {manifest_path}"

    try:
        with open(manifest_path) as f:
            data = json.load(f)
    except json.JSONDecodeError as e:
        return None, f"invalid JSON in {manifest_path}: {e}"

    # Always validate against schema using standard library
    err = validate_manifest(data, case_id)
    if err:
        return None, err

    # jsonschema is optional additional validation
    if jsonschema:
        try:
            jsonschema.validate(instance=data, schema=SCHEMA)
        except jsonschema.ValidationError as e:
            return None, f"jsonschema validation error in {case_id}: {e.message}"

    # Verify hashes (skip pending fields for draft cases)
    hashes = data.get("hashes", {})
    task_hash = hashes.get("task")
    check_hash = hashes.get("check")
    status = data.get("status")

    task_path = CASES_DIR / case_id / "task.md"
    check_path = CASES_DIR / case_id / "oracle" / "check.mjs"
    if not check_path.exists():
        check_path = CASES_DIR / case_id / "oracle" / "check.py"

    # Skip hash verification for draft cases with pending fields
    if status != "draft":
        # Non-draft cases: hash fields should not be "pending"
        if task_hash == "pending":
            return None, f"non-draft case {case_id} has pending hash for task.md (expected actual hash)"
        if check_hash == "pending":
            return None, f"non-draft case {case_id} has pending hash for oracle/check.* (expected actual hash)"

        if task_hash:
            actual_task = hash_file(task_path)
            if actual_task != task_hash:
                return None, f"hash mismatch in {case_id}: task.md expected {task_hash}, got {actual_task}"

        if check_hash:
            actual_check = hash_file(check_path)
            if actual_check != check_hash:
                return None, f"hash mismatch in {case_id}: oracle/check.* expected {check_hash}, got {actual_check}"
    else:
        # Draft cases: skip verification of pending fields
        if task_hash == "pending":
            pass  # OK for draft
        elif task_hash:
            actual_task = hash_file(task_path)
            if actual_task != task_hash:
                return None, f"hash mismatch in {case_id}: task.md expected {task_hash}, got {actual_task}"

        if check_hash == "pending":
            pass  # OK for draft
        elif check_hash:
            actual_check = hash_file(check_path)
            if actual_check != check_hash:
                return None, f"hash mismatch in {case_id}: oracle/check.* expected {check_hash}, got {actual_check}"

    return data, None


def hash_file(path):
    """Compute SHA-256 hash of a file."""
    h = hashlib.sha256()
    try:
        with open(path, "rb") as f:
            h.update(f.read())
        return h.hexdigest()
    except FileNotFoundError:
        return None


def has_executing_marker(check_source):
    """Check if the check source contains any executing markers."""
    exec_markers = [
        "vm.runInContext",
        "vm.runInNewContext",
        "vm.runInThisContext",
        "new vm.Script",
        "new Function(",
        "eval(",
    ]
    for marker in exec_markers:
        if marker in check_source:
            return True
    # Check for dynamic import of non-literal path (variable/expression, not string literal)
    # Match import(expr) where expr is NOT a string literal
    import_pattern = r"import\(\s*(?![\"\']).+?(?![\"\'])\s*\)"
    if re.search(import_pattern, check_source):
        return True
    return False


def is_text_matching_check(check_source):
    """Check if the check is text-matching (uses String.includes/regex on source without meaningful execution).

    A check is "text-matching" if:
    1. It has executing markers (vm.Script, etc.)
    2. BUT those markers do NOT actually execute the workspace source variable
    3. AND it has 3+ text pattern calls (.includes/.match/.test) on the source variable

    If the check has executing markers AND those markers actually run the workspace source code,
    then text-matching patterns on that source are acceptable (the check is executing).
    """
    includes_count = check_source.count(".includes(")
    match_count = len(re.findall(r'\.match\s*\(', check_source))
    test_count = len(re.findall(r'\.test\s*\(', check_source))

    total = includes_count + match_count + test_count

    # If no text patterns, not text-matching by this heuristic
    if total < 3:
        return False

    # Check if the check has a source variable and if vm.Script runs that variable
    # Look for patterns like: const source = ...; new vm.Script(source) or new vm.Script(code).run...
    source_var_patterns = [
        r'const\s+source\s*=\s*.*?fs\.readFileSync',
        r'let\s+source\s*=\s*.*?fs\.readFileSync',
        r'const\s+code\s*=\s*.*?fs\.readFileSync',
        r'let\s+code\s*=\s*.*?fs\.readFileSync',
    ]

    has_source_var = any(re.search(p, check_source) for p in source_var_patterns)

    # Check if workspace source is actually executed
    executes_source = False
    # Pattern: new vm.Script(VAR).runIn... or vm.runInContext(code, ...)
    execute_patterns = [
        r'new vm\.Script\s*\(\s*(?:source|code)\s*\)\.runIn',
        r'vm\.runInContext\s*\(\s*(?:source|code)',
        r'vm\.runInNewContext\s*\(\s*(?:source|code)',
        r'vm\.runInThisContext\s*\(\s*(?:source|code)',
    ]
    for pattern in execute_patterns:
        if re.search(pattern, check_source):
            executes_source = True
            break

    # If source is not actually executed, this is text-matching
    if not executes_source and has_source_var:
        return True

    return False


def lint_no_exec(check_path):
    """Lint a node-vm check for non-executing or text-matching patterns.

    Returns (exit_code, message) tuple. Exit 0 if valid, exit 2 with message if invalid.
    """
    if not check_path.exists():
        return 2, "check file not found"

    check_source = check_path.read_text(encoding="utf-8")

    # Check if it's a node-vm check (has any executing marker)
    if not has_executing_marker(check_source):
        return 2, "non-executing check: no vm.runIn*, new vm.Script, eval, new Function, or dynamic import found"

    # Check if it's text-matching (3+ text patterns on workspace source)
    if is_text_matching_check(check_source):
        return 2, "text-matching check: uses String.includes or regex on source without executing workspace code"

    return 0, ""


def classify_mutant_failure(result):
    """Classify a mutant failure as behavioral or structural.

    Only protocol-valid exit1 assertion results can be behavioral. Errors and
    structural diagnostics never count. These labels are diagnostics, not proof
    that an arbitrary check meaningfully exercised the workspace.
    Only `behavioral` failures count toward the >=2 mutant requirement.
    """
    exit_code = result.get("exit_code", 0)
    reason = result.get("reason", "")
    error = result.get("error", "")

    # Structural indicators
    if exit_code != 1 or result.get("protocol_valid") is not True or error:
        return "structural"

    reason_lower = (str(reason or "") + str(error or "")).lower()
    if "not found" in reason_lower or "unexpected structure" in reason_lower:
        return "structural"

    return "behavioral"


def get_oracle_commit():
    """Get the current git commit hash of the oracle repo."""
    try:
        result = subprocess.run(
            ["git", "rev-parse", "HEAD"],
            cwd=ROOT_DIR,
            capture_output=True,
            text=True,
            timeout=5
        )
        if result.returncode == 0:
            return result.stdout.strip()
    except Exception:
        pass
    return "unknown"


def is_valid_case_id(case_id):
    """Check if case_id is valid: letters, digits, ., _, -, 1-80 chars, starts with letter/digit."""
    if not case_id or len(case_id) > 80:
        return False
    pattern = r'^[a-zA-Z0-9][a-zA-Z0-9._-]*$'
    return bool(re.fullmatch(pattern, case_id))


def normalize_whitespace(text):
    """Normalize whitespace: collapse multiple spaces, strip leading/trailing."""
    return ' '.join(text.split())


def compute_signature(task_class, failure_class, why):
    """Compute SHA-256 signature for ledger record.

    Every field is whitespace-normalized and lowercased, then the fields are joined with the
    ASCII unit separator. str.split() treats that separator as whitespace, so normalized fields
    can never contain it and ("ab", "c") cannot collide with ("a", "bc").
    """
    parts = [normalize_whitespace(task_class).lower(),
             normalize_whitespace(failure_class).lower(),
             normalize_whitespace(why).lower()]
    return hashlib.sha256("\x1f".join(parts).encode('utf-8')).hexdigest()


def get_ledger_path():
    """Get the ledger captures.jsonl path."""
    return ROOT_DIR / "ledger" / "captures.jsonl"


def load_ledger_records():
    """Load all ledger records. Returns list of (line_num, record_or_error) tuples."""
    ledger_path = get_ledger_path()
    records = []
    if not ledger_path.exists():
        return records
    try:
        with open(ledger_path, 'r', encoding='utf-8') as f:
            for line_num, line in enumerate(f, 1):
                line = line.strip()
                if not line:
                    continue
                try:
                    record = json.loads(line)
                    records.append((line_num, record))
                except json.JSONDecodeError as e:
                    records.append((line_num, {"error": str(e), "line": line}))
    except Exception:
        pass
    return records


def write_ledger_record(record):
    """Append a record to the ledger file."""
    ledger_path = get_ledger_path()
    ledger_path.parent.mkdir(parents=True, exist_ok=True)
    with open(ledger_path, 'a', encoding='utf-8') as f:
        f.write(json.dumps(record, ensure_ascii=False) + '\n')


def first_case_for_signature(signature):
    """Return the case id of the earliest ledger record with this signature, or None."""
    for line_num, record in load_ledger_records():
        if isinstance(record, dict) and record.get("signature") == signature:
            return record.get("case_id")
    return None


def count_signature_repeats(signature):
    """Count how many times a signature appears in the ledger."""
    records = load_ledger_records()
    count = 0
    for line_num, record in records:
        if isinstance(record, dict) and record.get("signature") == signature:
            count += 1
    return count


def capture_case(case_id, why, task_class, runtime, suite, origin_repo, base_commit,
                 raw_commit, fix_commit, issue, pr, run_id, model, route, failure_class):
    """Create a draft case with the given metadata."""
    # Validate case_id
    if not case_id:
        print("Error: CASE_ID is required", file=sys.stderr)
        return 2
    if not is_valid_case_id(case_id):
        print(f"Error: CASE_ID must be letters, digits, '.', '_', '-', 1-80 chars, starting with letter/digit", file=sys.stderr)
        return 2

    # Validate why
    if not why:
        print("Error: --why is required", file=sys.stderr)
        return 2
    if len(why) > 1000:
        print(f"Error: --why must be at most 1000 characters (got {len(why)})", file=sys.stderr)
        return 2

    # Validate task_class
    if not task_class:
        print("Error: --task-class is required", file=sys.stderr)
        return 2

    # Validate runtime
    if runtime not in ENUM_VALIDATORS["runtime"]:
        print(f"Error: --runtime must be one of {ENUM_VALIDATORS['runtime']}", file=sys.stderr)
        return 2

    # Validate suite
    if suite not in ENUM_VALIDATORS["suite"]:
        print(f"Error: --suite must be one of {ENUM_VALIDATORS['suite']}", file=sys.stderr)
        return 2

    # Check case doesn't already exist
    case_dir = CASES_DIR / case_id
    if case_dir.exists():
        print(f"Error: case '{case_id}' already exists", file=sys.stderr)
        return 2

    # Compute signature
    sig = compute_signature(task_class, failure_class or "", why)

    # Count repeats (and remember which case first recorded this signature)
    repeat_count = count_signature_repeats(sig) + 1
    first_case = first_case_for_signature(sig) if repeat_count > 1 else None

    # Create case directory structure
    case_dir.mkdir(parents=True, exist_ok=True)
    (case_dir / "oracle").mkdir(exist_ok=True)
    (case_dir / "oracle" / ".gitkeep").write_text("")

    # Write task.md
    task_content = f"""# {why[:100]}

## Why
{why}

## References
"""
    refs = []
    if origin_repo:
        refs.append(f"- origin-repo: {origin_repo}")
    if base_commit:
        refs.append(f"- base-commit: {base_commit}")
    if raw_commit:
        refs.append(f"- raw-commit: {raw_commit}")
    if fix_commit:
        refs.append(f"- fix-commit: {fix_commit}")
    if issue:
        refs.append(f"- issue: {issue}")
    if pr:
        refs.append(f"- pr: {pr}")
    if run_id:
        refs.append(f"- run-id: {run_id}")
    if model:
        refs.append(f"- model: {model}")
    if route:
        refs.append(f"- route: {route}")
    if failure_class:
        refs.append(f"- failure-class: {failure_class}")
    task_content += '\n'.join(refs) + '\n'

    task_path = case_dir / "task.md"
    task_path.write_text(task_content, encoding='utf-8')
    task_hash = hash_file(task_path)

    # Create manifest
    manifest = {
        "id": case_id,
        "task_class": task_class,
        "runtime": runtime,
        "strength": "invariant-or-residual",  # Default for draft
        "status": "draft",
        "suite": suite,
        "hashes": {
            "input": "pending",
            "task": task_hash,
            "check": "pending"
        },
        "origin": {}
    }
    # Add origin fields if provided
    origin = {}
    if origin_repo:
        origin["origin-repo"] = origin_repo
    if base_commit:
        origin["base-commit"] = base_commit
    if raw_commit:
        origin["raw-commit"] = raw_commit
    if fix_commit:
        origin["fix-commit"] = fix_commit
    if issue:
        origin["issue"] = issue
    if pr:
        origin["pr"] = pr
    if run_id:
        origin["run-id"] = run_id
    if model:
        origin["failing-model"] = model
    if route:
        origin["failing-route"] = route
    if failure_class:
        origin["failure-class"] = failure_class
    if origin:
        manifest["origin"] = origin

    manifest_path = case_dir / "manifest.json"
    manifest_path.write_text(json.dumps(manifest, indent=2) + '\n', encoding='utf-8')

    # Write ledger record
    now = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    record = {
        "id": f"{now}_{case_id}",
        "timestamp": now,
        "case_id": case_id,
        "task_class": task_class,
        "failure_class": failure_class or "",
        "runtime": runtime,
        "why": why,
        "signature": sig,
        "repeat_count": repeat_count
    }
    # Add origin fields to ledger record
    if origin:
        record["origin"] = origin

    write_ledger_record(record)

    print(f"Created draft case '{case_id}'")
    print(f"  - task: {task_path}")
    print(f"  - manifest: {manifest_path}")
    print(f"  - ledger record: signature={sig[:16]}..., repeat_count={repeat_count}")
    if repeat_count > 1:
        print(f"repeat of {first_case} (count {repeat_count})")

    return 0


def list_cases(suite=None, status=None):
    """List all cases, optionally filtered by suite and status."""
    cases = []
    for manifest_path in CASES_DIR.glob("*/manifest.json"):
        case_id = manifest_path.parent.name
        manifest, err = load_manifest(case_id)
        if err:
            print(f"Error loading {case_id}: {err}", file=sys.stderr)
            continue
        cases.append(manifest)

    # Filter
    if suite:
        cases = [c for c in cases if c.get("suite") == suite]
    if status:
        cases = [c for c in cases if c.get("status") == status]

    # Sort by ID
    cases.sort(key=lambda x: x.get("id", ""))

    # Print table header
    print(f"{'ID':<30} {'Runtime':<12} {'Strength':<25} {'Status':<12} {'Suite':<10}")
    print("-" * 90)

    for c in cases:
        cid = c.get("id", "")
        runtime = c.get("runtime", "")
        strength = c.get("strength", "")
        stat = c.get("status", "")
        suite_name = c.get("suite", "")
        print(f"{cid:<30} {runtime:<12} {strength:<25} {stat:<12} {suite_name:<10}")


def ledger_command(repeats=False):
    """Print ledger records or repeat signatures."""
    records = load_ledger_records()

    if repeats:
        # Count signatures
        sig_counts = {}
        for line_num, record in records:
            if isinstance(record, dict) and "signature" in record:
                sig = record["signature"]
                sig_counts[sig] = sig_counts.get(sig, 0) + 1

        # Print only signatures with count >= 2
        found_any = False
        for sig, count in sorted(sig_counts.items()):
            if count >= 2:
                found_any = True
                # Find case_id for this signature
                case_ids = []
                for line_num, record in records:
                    if isinstance(record, dict) and record.get("signature") == sig:
                        case_ids.append(record.get("case_id", "unknown"))
                print(f"signature={sig[:16]}... case={' '.join(case_ids)} count={count}")

        if not found_any:
            print("No repeat signatures found")
            return 0
        return 0

    # Print all records
    if not records:
        print("No ledger records found")
        return 0

    print(f"{'ID':<40} {'Timestamp':<20} {'Case':<20} {'Task Class':<20} {'Repeat'}")
    print("-" * 100)

    for line_num, record in records:
        if isinstance(record, dict) and "error" in record:
            # Malformed line
            err_msg = record.get("error", "unknown error")
            print(f"LINE {line_num}: malformed - {err_msg}")
        elif isinstance(record, dict):
            case_id = record.get("case_id", "")
            task_class = record.get("task_class", "")
            repeat = record.get("repeat_count", 1)
            # Extract just the timestamp portion for display
            timestamp = record.get("timestamp", "")
            rec_id = record.get("id", "")
            print(f"{rec_id:<40} {timestamp:<20} {case_id:<20} {task_class:<20} {repeat}")

    return 0


def run_case(case_id, workspace, runtime=None, timeout=120, json_output=False):
    """Run a case check against a workspace."""
    manifest, err = load_manifest(case_id)
    if err:
        print(json.dumps({"ok": False, "error": err}), file=sys.stderr)
        return 2

    # Reject draft cases
    if manifest.get("status") == "draft":
        print(json.dumps({"ok": False, "error": "draft case, no oracle yet"}), file=sys.stderr)
        return 2

    # Use manifest runtime if not specified
    check_runtime = runtime or manifest.get("runtime", "")

    if check_runtime == "browser":
        print(json.dumps({"ok": False, "error": "unsupported runtime: browser"}))
        return 2

    check_path = CASES_DIR / case_id / "oracle" / "check.mjs"
    if not check_path.exists():
        check_path = CASES_DIR / case_id / "oracle" / "check.py"

    if not check_path.exists():
        print(json.dumps({"ok": False, "error": f"check not found: {check_path}"}))
        return 2

    start_time = time.monotonic()
    data = run_workspace(check_path, workspace, case_id, "candidate", timeout=timeout)
    data.update(case=case_id, runtime=check_runtime,
                strength=manifest.get("strength", ""), status=manifest.get("status", ""),
                commit=get_oracle_commit(), elapsed=time.monotonic() - start_time)
    print(json.dumps(data, indent=2 if json_output else None))
    return data["exit_code"]


def validate_case(case_id, raw_dir, fix_dir, mutants=None, write=False):
    """Validate a case against raw, fix, and mutant workspaces."""
    manifest, err = load_manifest(case_id)
    if err:
        print(f"Error: {err}", file=sys.stderr)
        return 1

    # Reject draft cases
    if manifest.get("status") == "draft":
        print(f"Error: draft case, no oracle yet", file=sys.stderr)
        return 2

    check_path = CASES_DIR / case_id / "oracle" / "check.mjs"
    if not check_path.exists():
        check_path = CASES_DIR / case_id / "oracle" / "check.py"

    if not check_path.exists():
        print(f"Error: check not found: {check_path}", file=sys.stderr)
        return 1

    # Run no-exec lint for node-vm checks
    runtime = manifest.get("runtime", "")
    if runtime == "node-vm":
        lint_exit, lint_msg = lint_no_exec(check_path)
        if lint_exit != 0:
            print(f"Validation FAILED: {lint_msg}", file=sys.stderr)
            return 2

    mutants = mutants or {}
    if set(mutants) & {"raw", "fix"}:
        print("Validation FAILED: mutant names raw and fix are reserved", file=sys.stderr)
        return 2
    mutant_paths = [Path(value).resolve() for value in mutants.values()]
    if len(set(mutant_paths)) != len(mutant_paths):
        print("Validation FAILED: mutant workspaces must be distinct", file=sys.stderr)
        return 2
    results = {}

    # Run on raw (should FAIL)
    results["raw"] = run_workspace(check_path, raw_dir, case_id, "raw")

    # Run on fix (should PASS)
    results["fix"] = run_workspace(check_path, fix_dir, case_id, "fix")

    # Run on mutants
    if mutants:
        for name, dir in mutants.items():
            results[name] = run_workspace(check_path, dir, case_id, name)
    else:
        # If no mutants provided, create a warning
        print("Warning: No mutants provided, at least 2 required", file=sys.stderr)

    # Check admission procedure
    errors = []

    if results["raw"]["exit_code"] != 1 or classify_mutant_failure(results["raw"]) != "behavioral":
        errors.append(f"raw: expected exit 1 (fail), got {results['raw']['exit_code']}")

    if results["fix"]["exit_code"] != 0:
        errors.append(f"fix: expected exit 0 (pass), got {results['fix']['exit_code']}")

    # Count mutants that failed
    failed_mutants = sum(1 for name, r in results.items() if name not in ("raw", "fix") and r["exit_code"] == 1)

    if failed_mutants < 2:
        errors.append(f"mutants: at least 2 must fail, only {failed_mutants} failed")

    for name, r in results.items():
        if name in ("raw", "fix"):
            continue
        if r["exit_code"] != 1:
            errors.append(f"{name}: expected exit 1 (fail), got {r['exit_code']}")

    # Count behavioral vs structural mutant failures
    behavioral_count = 0
    structural_count = 0
    for name, r in results.items():
        if name in ("raw", "fix"):
            continue
        if r["exit_code"] == 1:  # Failed mutant
            classification = classify_mutant_failure(r)
            if classification == "behavioral":
                behavioral_count += 1
            else:
                structural_count += 1

    # The >=2 mutant requirement only counts behavioral failures
    failed_mutants = behavioral_count

    if failed_mutants < 2:
        errors.append(f"mutants: at least 2 behavioral must fail, only {failed_mutants} failed (structural: {structural_count})")

    # Print table
    print(f"{'Workspace':<15} {'Exit':<6} {'OK':<6} {'Result'}")
    print("-" * 70)
    for name, r in results.items():
        ok_str = "✓" if r["ok"] else "✗"
        print(f"{name:<15} {r['exit_code']:<6} {ok_str:<6} {r.get('reason', '')}")

    if errors:
        print("\nValidation FAILED:")
        for e in errors:
            print(f"  - {e}")
        verdict = False
    else:
        print("\nValidation PASSED")
        verdict = True

    # Write report if requested
    if write:
        report_dir = CASES_DIR / case_id / "validation"
        report_dir.mkdir(exist_ok=True)
        report = {
            "timestamp": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
            "commit": get_oracle_commit(),
            "results": results,
            "verdict": verdict,
            "mutant_failures": {
                "behavioral": behavioral_count,
                "structural": structural_count
            }
        }
        with open(report_dir / "report.json", "w") as f:
            json.dump(report, f, indent=2)
        print(f"\nReport written to {report_dir / 'report.json'}")
        print(f"Mutant failure breakdown: behavioral={behavioral_count}, structural={structural_count}")

    return 0 if verdict else 1


def run_workspace(check_path, workspace, case_id, workspace_name, timeout=120):
    """Execute a check; invalid result protocols are inconclusive, never detections."""
    if check_path.suffix == ".mjs":
        cmd = ["node", str(check_path), str(workspace)]
    elif check_path.suffix == ".py":
        cmd = [sys.executable, str(check_path), str(workspace)]
    else:
        return {"exit_code": 2, "ok": False, "protocol_valid": False,
                "outcome": "inconclusive", "reason": f"unknown type: {check_path.suffix}"}
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except (subprocess.TimeoutExpired, OSError) as exc:
        return {"exit_code": 2, "ok": False, "protocol_valid": False,
                "outcome": "inconclusive", "reason": str(exc),
                "error": f"timeout after {timeout}s" if isinstance(exc, subprocess.TimeoutExpired) else str(exc),
                "timeout": isinstance(exc, subprocess.TimeoutExpired)}
    evidence = {"process_exit_code": result.returncode,
                "stdout": result.stdout.strip(), "stderr": result.stderr.strip()}
    try:
        data = json.loads(result.stdout)
    except (json.JSONDecodeError, ValueError):
        data = None
    valid = (isinstance(data, dict) and type(data.get("ok")) is bool
             and result.returncode in (0, 1)
             and data["ok"] == (result.returncode == 0))
    if not valid:
        return dict(evidence, exit_code=2, ok=False, protocol_valid=False,
                    outcome="inconclusive", reason="invalid or inconsistent check result protocol")
    # An explicit error is not evidence of a failed behavioral assertion.
    if data.get("error"):
        return dict(data, **evidence, exit_code=2, ok=False, protocol_valid=True,
                    outcome="inconclusive", reason=str(data["error"]))
    data.update(evidence)
    data.update(exit_code=result.returncode, protocol_valid=True,
                outcome="pass" if data["ok"] else "fail")
    data["reason"] = str(data.get("reason", ""))
    return data


def leakcheck(workspace):
    """Check if workspace leaks oracle content."""
    workspace_path = Path(workspace).resolve()
    leaks = []

    # Build restricted paths set
    restricted_paths = set()
    restricted_files = []

    for pattern in RESTRICTED_DIRS:
        if pattern.startswith("cases/*/"):
            for case_dir in CASES_DIR.glob("*/"):
                for subdir in ["oracle", "validation"]:
                    restricted = case_dir / subdir
                    if restricted.exists():
                        restricted_paths.add(restricted.resolve())
                        # Collect all files under this directory (following symlinks)
                        for f in restricted.rglob("*"):
                            try:
                                if f.is_file():
                                    restricted_files.append(f.resolve())
                            except Exception:
                                pass
        elif pattern == "registry/":
            restricted = ROOT_DIR / "registry"
            if restricted.exists():
                restricted_paths.add(restricted.resolve())
                for f in restricted.rglob("*"):
                    try:
                        if f.is_file():
                            restricted_files.append(f.resolve())
                    except Exception:
                        pass
        elif pattern == "ledger/":
            restricted = ROOT_DIR / "ledger"
            if restricted.exists():
                restricted_paths.add(restricted.resolve())
                for f in restricted.rglob("*"):
                    try:
                        if f.is_file():
                            restricted_files.append(f.resolve())
                    except Exception:
                        pass

    # Compute hashes of restricted files
    restricted_hashes = {}
    for f in restricted_files:
        try:
            h = hash_file(f)
            if h:
                restricted_hashes[h] = f
        except Exception:
            pass

    # Check if workspace path itself is inside a restricted directory
    for restricted_path in restricted_paths:
        try:
            rel = workspace_path.relative_to(restricted_path)
            leaks.append(f"workspace inside restricted: {workspace_path} (under {restricted_path})")
        except ValueError:
            pass

    # Traverse workspace, following directory symlinks safely (with cycle detection)
    visited_real_dirs = set()
    if workspace_path.exists():
        # We need to manually walk directories to follow symlinks
        def walk_with_symlinks(dir_path):
            """Walk directory tree following symlinks, tracking visited real paths to avoid cycles."""
            try:
                real_path = dir_path.resolve()
                # If we've already visited this real path, skip to avoid cycles
                if real_path in visited_real_dirs:
                    return
                visited_real_dirs.add(real_path)

                # Iterate over directory entries
                try:
                    with os.scandir(dir_path) as entries:
                        for entry in entries:
                            try:
                                entry_path = Path(entry.path)

                                # Check if this entry is a symlink to a restricted path
                                if entry_path.is_symlink():
                                    try:
                                        resolved = entry_path.resolve()
                                        # Check if symlink points inside a restricted directory
                                        for restricted_path in restricted_paths:
                                            try:
                                                rel = resolved.relative_to(restricted_path)
                                                leaks.append(f"symlink to restricted: {entry_path} -> {resolved} (under {restricted_path})")
                                            except ValueError:
                                                pass
                                        # Check if resolved path is a file with matching hash
                                        if resolved.is_file():
                                            h = hash_file(resolved)
                                            if h and h in restricted_hashes:
                                                leaks.append(f"identical file: {entry_path} -> {resolved} (matches {restricted_hashes[h]})")
                                        # If it's a symlink to a directory, recurse into it
                                        elif resolved.is_dir():
                                            walk_with_symlinks(entry_path)
                                    except (OSError, FileNotFoundError):
                                        # Dangling symlink - skip with note
                                        pass

                                elif entry.is_dir():
                                    # Regular directory, recurse
                                    walk_with_symlinks(entry_path)

                                elif entry.is_file():
                                    # Regular file - check for hash match
                                    try:
                                        h = hash_file(entry_path)
                                        if h and h in restricted_hashes:
                                            leaks.append(f"identical file: {entry_path} (matches {restricted_hashes[h]})")
                                    except Exception:
                                        pass

                            except Exception:
                                pass
                except (OSError, PermissionError):
                    pass

            except Exception:
                pass

        walk_with_symlinks(workspace_path)

    if leaks:
        print("Leakcheck FAILED - offending paths:")
        for leak in leaks:
            print(f"  - {leak}")
        return 1
    else:
        print("Leakcheck PASSED")
        return 0


def main():
    parser = argparse.ArgumentParser(
        prog="oracle",
        description="Oracle CLI: load case manifests, run checks, validate against workspaces"
    )
    subparsers = parser.add_subparsers(dest="command", help="Commands")

    # list command
    list_parser = subparsers.add_parser("list", help="List cases")
    list_parser.add_argument("--suite", choices=["tuning", "heldout"], help="Filter by suite")
    list_parser.add_argument("--status", choices=["probation", "active", "retired", "draft"], help="Filter by status")

    # run command
    run_parser = subparsers.add_parser("run", help="Run a case check")
    run_parser.add_argument("case", help="Case ID")
    run_parser.add_argument("workspace", help="Workspace directory")
    run_parser.add_argument("--runtime", help="Override runtime")
    run_parser.add_argument("--timeout", type=float, default=120, help="Timeout in seconds (default: 120)")
    run_parser.add_argument("--json", action="store_true", help="Pretty print JSON output")

    # validate command
    validate_parser = subparsers.add_parser("validate", help="Validate case against workspaces")
    validate_parser.add_argument("case", help="Case ID")
    validate_parser.add_argument("--raw", required=True, help="Raw workspace directory")
    validate_parser.add_argument("--fix", required=True, help="Fix workspace directory")
    validate_parser.add_argument("--mutant", action="append", help="Mutant name=dir (can be repeated)")
    validate_parser.add_argument("--write", action="store_true", help="Write validation report")

    # leakcheck command
    leakcheck_parser = subparsers.add_parser("leakcheck", help="Check for oracle leakage")
    leakcheck_parser.add_argument("workspace", help="Workspace directory")

    # capture command
    capture_parser = subparsers.add_parser("capture", help="Create a draft case")
    capture_parser.add_argument("case_id", help="Case ID")
    capture_parser.add_argument("--why", required=True, help="Why this case was created (required, max 1000 chars)")
    capture_parser.add_argument("--task-class", required=True, help="Task class (e.g., 'bug', 'test')")
    capture_parser.add_argument("--runtime", choices=["python", "node-vm", "browser"], default="node-vm", help="Runtime")
    capture_parser.add_argument("--suite", choices=["tuning", "heldout"], default="tuning", help="Suite")
    capture_parser.add_argument("--origin-repo", help="Origin repository (e.g., OWNER/REPO)")
    capture_parser.add_argument("--base-commit", help="Base commit SHA")
    capture_parser.add_argument("--raw-commit", help="Raw commit SHA")
    capture_parser.add_argument("--fix-commit", help="Fix commit SHA")
    capture_parser.add_argument("--issue", help="Issue reference (e.g., wcc118/oracles#3)")
    capture_parser.add_argument("--pr", help="PR reference")
    capture_parser.add_argument("--run-id", help="Run ID")
    capture_parser.add_argument("--model", help="Model name")
    capture_parser.add_argument("--route", help="Route name")
    capture_parser.add_argument("--failure-class", help="Failure class")

    # ledger command
    ledger_parser = subparsers.add_parser("ledger", help="Show ledger records")
    ledger_parser.add_argument("--repeats", action="store_true", help="Show only repeat signatures")

    args = parser.parse_args()

    if args.command == "list":
        list_cases(suite=args.suite, status=args.status)
    elif args.command == "capture":
        exit(capture_case(
            case_id=args.case_id,
            why=args.why,
            task_class=args.task_class,
            runtime=args.runtime,
            suite=args.suite,
            origin_repo=args.origin_repo,
            base_commit=args.base_commit,
            raw_commit=args.raw_commit,
            fix_commit=args.fix_commit,
            issue=args.issue,
            pr=args.pr,
            run_id=args.run_id,
            model=args.model,
            route=args.route,
            failure_class=args.failure_class
        ))
    elif args.command == "ledger":
        exit(ledger_command(repeats=args.repeats))
    elif args.command == "run":
        exit(run_case(args.case, args.workspace, args.runtime, args.timeout, args.json))
    elif args.command == "validate":
        mutants = {}
        if args.mutant:
            for m in args.mutant:
                if "=" in m:
                    name, dir = m.split("=", 1)
                    mutants[name] = dir
        exit(validate_case(args.case, args.raw, args.fix, mutants, args.write))
    elif args.command == "leakcheck":
        exit(leakcheck(args.workspace))
    else:
        parser.print_help()
        exit(1)


if __name__ == "__main__":
    main()
